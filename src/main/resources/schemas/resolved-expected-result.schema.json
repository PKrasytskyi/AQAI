{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resolved-expected-result.v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "testCaseId",
    "candidateRequirementId",
    "expectedValue",
    "confidence",
    "status",
    "rationale"
  ],
  "properties": {
    "schemaVersion": { "const": "resolved-expected-result.v1" },
    "testCaseId": { "type": "string", "minLength": 1 },
    "candidateRequirementId": { "type": "string" },
    "expectedValue": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "status": { "enum": ["resolved", "needs-review"] },
    "rationale": { "type": "string" }
  },
  "additionalProperties": false
}
