# Required for the live OrangeHRM Build Week demo. Do not commit a populated .env.
OPENAI_API_KEY=

# OrangeHRM public demo environment.
# These credentials are intentionally public and contain no sensitive data.
TEST_VALID_USERNAME="Admin"
TEST_VALID_PASSWORD="admin123"

# Required only by docker-compose.build-week.yml. Use a local development password.
KNOWLEDGE_GRAPH_NEO4J_PASSWORD=change-me-for-local-demo

# Public GHCR image defaults. Override for a fork or a locally tagged image.
AQAI_IMAGE=ghcr.io/pkrasytskyi/aqai-build-week
AQAI_IMAGE_TAG=2026
