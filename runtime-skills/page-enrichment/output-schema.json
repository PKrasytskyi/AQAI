    "pageId": {"type": "string"},
    "pageName": {"type": "string"},
    "route": {"type": "string"},
    "businessIntent": {"type": "string"},
    "pageSummary": {"type": "string"},
    "supportedActions": {"type": "array", "items": {"type": "string"}, "maxItems": 5},
    "stableLocators": {"type": "array", "items": {"type": "string"}, "maxItems": 5},
    "preconditions": {"type": "array", "items": {"type": "string"}, "maxItems": 5},
    "postconditions": {"type": "array", "items": {"type": "string"}, "maxItems": 5},
    "risks": {"type": "array", "items": {"type": "string"}, "maxItems": 5},
    "coverageGaps": {"type": "array", "items": {"type": "string"}, "maxItems": 5},
    "requirementTraceability": {"type": "array", "items": {"type": "string"}},
    "confidenceScore": {"type": "number", "minimum": 0, "maximum": 1}
